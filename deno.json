{
	"tasks": {
		"install_dash": "deno install -A --reload -f -n dash_compiler https://raw.githubusercontent.com/bridge-core/deno-dash-compiler/main/mod.ts",
		"watch": "dash_compiler build --mode development && dash_compiler watch",
		"build": "dash_compiler build"
	},
	"imports": {
		"@minecraft/server": "npm:@minecraft/server@2.11.0",
		"@minecraft/server-graphics": "npm:@minecraft/server-graphics@1.0.0"
	},
	"unstable": [
		"sloppy-imports"
	]
}