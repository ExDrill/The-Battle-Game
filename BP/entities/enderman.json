{
    "format_version": "1.26.50",
    "minecraft:entity": {
        "description": {
            "identifier": "battle:enderman",
            "is_spawnable": true,
            "is_summonable": true
        },
        "component_groups": {
            "battle:default_ambient_sound": {
                "minecraft:ambient_sound_interval": {
                    "event_name": "ambient",
                    "range": 16,
                    "value": 8
                }
            },
            "battle:angry_ambient_sound": {
                "minecraft:ambient_sound_interval": {
                    "event_name": "ambient.tame",
                    "range": 4,
                    "value": 2
                }
            }
        },
        "components": {
            "minecraft:health": {
                "value": 100,
                "max": 100
            },
            "minecraft:movement": {
                "value": 0.3
            },
            "minecraft:attack": {
                "damage": 10
            },
            "minecraft:knockback_resistance": {
                "value": 1
            },
            "minecraft:type_family": {
                "family": [
                    "enderman",
                    "boss",
                    "monster",
                    "mob"
                ]
            },
            "minecraft:collision_box": {
                "width": 0.6,
                "height": 2.9
            },
            "minecraft:breathable": {
                "total_supply": 15,
                "breathes_air": true,
                "breathes_water": false
            },
            "minecraft:experience_reward": {
                "on_death": "query.last_hit_by_player ? 20 : 0"
            },
            "minecraft:loot": {
                "table": "loot_tables/empty.json"
            },
            "minecraft:teleport": {
                "random_teleports": true,
                "min_random_teleport_time": 10,
                "max_random_teleport_time": 30,
                "random_teleport_cube": [16, 8, 16],
                "light_teleport_chance": 0.05,
                "dark_teleport_chance": 0.05
            },
            "minecraft:looked_at": {
                "search_radius": 16,
                "find_players_only": true,
                "look_at_locations": [
                    {
                        "location": "head",
                        "vertical_offset": 1
                    }
                ],
                "set_target": "once_and_stop_scanning"
            },
            "minecraft:hurt_on_condition": {
                "damage_conditions": [
                    {
                        "filters": {
                            "test": "in_lava",
                            "value": true
                        },
                        "cause": "lava",
                        "damage_per_tick": 4
                    },
                    {
                        "filters": {
                            "test": "in_contact_with_water",
                            "value": true
                        },
                        "cause": "drowning",
                        "damage_per_tick": 1
                    }
                ]
            },
            "minecraft:behavior.hurt_by_target": {
                "priority": 1
            },
            "minecraft:behavior.nearest_attackable_target": {
                "priority": 2,
                "must_see": false,
                "entity_types": {
                    "filters": {
                        "test": "is_family",
                        "subject": "other",
                        "value": "beacon"
                    },
                    "max_dist": 32
                }
            },
            "minecraft:behavior.delayed_attack": {
                "priority": 3,
                "random_stop_interval": 0,
                "reach_multiplier": 5.0,
                "attack_duration": 0.75,
                "hit_delay_pct": 0.66,
                "speed_multiplier": 2
            },
            "minecraft:behavior.random_stroll": {
                "priority": 4
            },
            "minecraft:behavior.look_at_player": {
                "priority": 5,
                "look_distance": 6
            },
            "minecraft:behavior.random_look_around": {
                "priority": 6
            },
            "minecraft:on_target_acquired": {
                "event": "battle:on_target_acquired"
            },
            "minecraft:on_target_escape": {
                "event": "battle:on_target_escape"
            },
            "minecraft:movement.basic": {},
            "minecraft:navigation.walk": {},
            "minecraft:jump.static": {},
            "minecraft:can_climb": {},
            "minecraft:nameable": {},
            "minecraft:physics": {},
            "minecraft:persistent": {},
            "minecraft:pushable_by_entity": {},
            "minecraft:pushable_by_block": {},
            "minecraft:is_hidden_when_invisible": {},
            "minecraft:conditional_bandwidth_optimization": {}
        },
        "events": {
            "minecraft:entity_spawned": {
                "add": {
                    "component_groups": [
                        "battle:default_ambient_sound"
                    ]
                }
            },
            "battle:on_target_acquired": {
                "add": {
                    "component_groups": [
                        "battle:angry_ambient_sound"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "battle:default_ambient_sound"
                    ]
                }
            },
            "battle:on_target_escape": {
                "add": {
                    "component_groups": [
                        "battle:default_ambient_sound"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "battle:angry_ambient_sound"
                    ]
                }
            }
        }
    }
}